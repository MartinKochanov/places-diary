{
  "expo": {
    "name": "places-diary",
    "slug": "places-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.martin.placesdiary",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "The app needs your location to mark places you have visited on the map.",
        "NSPhotoLibraryUsageDescription": "The app accesses your photos to let you add images of your visited places."
      }
    },
    "android": {
      "package": "com.martin.placesdiary",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you add images of your visited places."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The app needs your location to mark places you have visited on the map."
        }
      ]
    ]
  }
}
